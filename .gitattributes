# ============================================
# Git 属性配置 - 强制统一换行符和文件类型
# 解决 Windows / macOS / Linux 协作时的换行混乱
# 注意：.gitattributes 不支持行内注释，需要说明请另起行
# ============================================

# 默认所有文本文件自动检测，行尾标准化为 LF
*               text=auto eol=lf

# --- 明确指定常见代码文件类型 ---
*.py            text eol=lf
*.js            text eol=lf
*.mjs           text eol=lf
*.cjs           text eol=lf
*.ts            text eol=lf
*.jsx           text eol=lf
*.tsx           text eol=lf
*.vue           text eol=lf
*.scss          text eol=lf
*.sass          text eol=lf
*.css           text eol=lf
*.html          text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.xml           text eol=lf
*.svg           text eol=lf
*.sh            text eol=lf

# Windows 平台脚本：强制 CRLF
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Django 模板
*.html.django   text eol=lf

# 配置文件
.gitattributes  text eol=lf
.editorconfig   text eol=lf
.gitignore      text eol=lf
.eslintrc       text eol=lf
.eslintrc.js    text eol=lf
.eslintrc.json  text eol=lf
.prettierrc     text eol=lf

# --- 二进制文件 - 禁止任何转换 ---
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.bmp           binary
*.ico           binary
*.webp          binary
*.pdf           binary
*.zip           binary
*.rar           binary
*.7z            binary
*.tar           binary
*.gz            binary
*.docx          binary
*.xlsx          binary
*.xls           binary
*.pptx          binary
*.ppt           binary
*.db            binary
*.sqlite3       binary
*.pyc           binary
*.pyo           binary
*.pyd           binary
*.so            binary
*.dll           binary
*.exe           binary
*.node          binary
